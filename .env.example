# Copy this file to .env.local for local development.
# Release deploys create .env on each droplet from the GitHub workflow.
# NEVER commit real values: only this example file goes to Git.

NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8080

# Auth0 Regular Web Application dedicated to Admin (server-only).
# Configure APP_URL/auth/callback and APP_URL as allowed callback/logout URLs.
# APP_URL is explicitly passed to the SDK as appBaseUrl.
AUTH0_DOMAIN=your-admin-tenant.auth0.com
# Dedicated database connection selected and enforced by Admin on every login.
AUTH0_CONNECTION=your-admin-database-connection
# API identifier configured in Auth0; never expose the access token to the browser.
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate a dedicated encryption secret with: openssl rand -hex 32
AUTH0_SECRET=
